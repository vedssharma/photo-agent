# Copy to .env (make dev does this for you) and fill in. .env is git-ignored.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: the Claude model that drives the editing agent (default claude-opus-5-5)
# ANTHROPIC_MODEL=
# Optional: the smaller model for routine requests ("a bit brighter"), the safety screen,
# and quick analyses (default claude-sonnet-5-5). Set it to ANTHROPIC_MODEL to always use one.
# ANTHROPIC_ROUTINE_MODEL=

# Optional: learn the person's taste from edits they keep and undo (default true).
# STYLE_MEMORY=false

# Optional: AI models for local edits (sky, subjects, object removal, ...).
# Install them with `cd server && uv sync --extra models`; without them, each task uses a
# rougher classical fallback. Set MODEL_BACKENDS=classical to never load model weights.
# MODEL_BACKENDS=auto
# MODEL_DEVICE=auto          # auto, cpu, cuda, or mps
# MODEL_DIR=                 # where weights are cached (default .data/models)
